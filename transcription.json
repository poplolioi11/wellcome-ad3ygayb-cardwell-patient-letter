          "columns": [
            {
              "text": "向有□瘡成管因勞傷怒傷"
            },
            {
              "text": "致令□虛氣虛火上行到頭頂"
            },
            {
              "text": "風雨更勝甚激戰搖動心想"
            },
            {
              "text": "不得口言不得耳目視听不得病"
            },
            {
              "text": "在心肝腎虛□□真陰不足"
            },
            {
              "text": "在臟府經絡膜不惟向前後"
            },
            {
              "text": "皆□去引無形四肢麻表肉□"
            },
            {
              "text": "大空又有虛氣總是上衝而□"
            },
            {
              "text": "日夜不爽快在肝筋前激後□時散"
            },
            {
              "text": "時收散則空鼓收如硬棍"
            },
            {
              "text": "如針□□"
            },
            {
              "text": "請發方"
            }
          ],
