          "side": "single",
          "columns": [
            {
              "text": "向有□瘡成管因勞傷怒傷"
            },
            {
              "text": "致令中虛氣上虛火上行到頭頂"
            },
            {
              "text": "風雨更□甚□戰搖動心想"
            },
            {
              "text": "不得口言不得耳目視聽不得病"
            },
            {
              "text": "在心肝腎虛□□真陰不足"
            },
            {
              "text": "在臟腑經絡□不惟向前後"
            },
            {
              "text": "皆□去引無形四肢麻表肉□"
            },
            {
              "text": "大空又有虛氣總是上衝而□"
            },
            {
              "text": "日夜不爽快在肝節前□後□時散"
            },
            {
              "text": "時收散則空鼓收如硬棍"
            },
            {
              "text": "如針□□"
            },
            {
              "text": "請發方"
            }
          ],
