        <div n="1" type="scan" subtype="illustrated-patient-letter">
          <div type="page-face" n="single">
            <ab type="column" n="1" xml:id="f01-s-c01">
              <seg type="diplomatic-text">向有□瘡成管因勞傷怒傷</seg>
            </ab>
            <ab type="column" n="2" xml:id="f01-s-c02">
              <seg type="diplomatic-text">致令中虛氣上虛火上行到頭頂</seg>
            </ab>
            <ab type="column" n="3" xml:id="f01-s-c03">
              <seg type="diplomatic-text">風雨更□甚□戰搖動心想</seg>
            </ab>
            <ab type="column" n="4" xml:id="f01-s-c04">
              <seg type="diplomatic-text">不得口言不得耳目視聽不得病</seg>
            </ab>
            <ab type="column" n="5" xml:id="f01-s-c05">
              <seg type="diplomatic-text">在心肝腎虛□□真陰不足</seg>
            </ab>
            <ab type="column" n="6" xml:id="f01-s-c06">
              <seg type="diplomatic-text">在臟腑經絡□不惟向前後</seg>
            </ab>
            <ab type="column" n="7" xml:id="f01-s-c07">
              <seg type="diplomatic-text">皆□去引無形四肢麻表肉□</seg>
            </ab>
            <ab type="column" n="8" xml:id="f01-s-c08">
              <seg type="diplomatic-text">大空又有虛氣總是上衝而□</seg>
            </ab>
            <ab type="column" n="9" xml:id="f01-s-c09">
              <seg type="diplomatic-text">日夜不爽快在肝節前□後□時散</seg>
            </ab>
            <ab type="column" n="10" xml:id="f01-s-c10">
              <seg type="diplomatic-text">時收散則空鼓收如硬棍</seg>
            </ab>
            <ab type="column" n="11" xml:id="f01-s-c11">
              <seg type="diplomatic-text">如針□□</seg>
            </ab>
            <ab type="column" n="12" xml:id="f01-s-c12">
              <seg type="diplomatic-text">請發方</seg>
            </ab>
            <ab type="page-feature" subtype="manuscript-annotation" corresp="#f01-s-c01">
              <label>第1欄右側下段，上字</label>
              <seg type="diplomatic-text" rend="unknown">先</seg>
            </ab>
            <ab type="page-feature" subtype="manuscript-annotation" corresp="#f01-s-c01">
              <label>第1欄右側下段，下字</label>
              <seg type="diplomatic-text" rend="unknown">後</seg>
            </ab>
            <ab type="page-feature" subtype="manuscript-annotation" corresp="#f01-s-c04">
              <label>第4、5欄中下之間</label>
              <seg type="diplomatic-text" rend="unknown">怪</seg>
            </ab>
            <ab type="page-feature" subtype="manuscript-annotation" corresp="#f01-s-c05">
              <label>第5、6欄上中之間</label>
              <seg type="diplomatic-text" rend="unknown">痰氣在肉內膜外</seg>
            </ab>
            <ab type="page-feature" subtype="manuscript-annotation" corresp="#f01-s-c08">
              <label>第8欄下緣偏右</label>
              <seg type="diplomatic-text" rend="unknown">〔字數未定〕</seg>
            </ab>
            <ab type="page-feature" subtype="figure-label" facs="#f01-drawing">
              <label>右側人體圖斜標，較上</label>
              <seg type="diplomatic-text" rend="unknown">〔字數未定〕此邊</seg>
            </ab>
            <ab type="page-feature" subtype="figure-label" facs="#f01-drawing">
